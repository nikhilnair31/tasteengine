{
  "manifest_version": 3,
  "name": "Taste Engine Saver",
  "version": "1.5.6",
  "browser_specific_settings": {
    "gecko": {
      "id": "taste-engine-saver@local",
      "strict_min_version": "128.0"
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  },
  "description": "Save pages, images, links and selections to your Taste Engine.",
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "activeTab",
    "tabs",
    "scripting",
    "privateNetworkAccess",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8770/*",
    "http://*/*",
    "https://*/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_title": "Taste Engine: save this page",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
