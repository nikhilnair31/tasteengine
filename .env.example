# Taste Engine service config. Copy to .env and fill in. Never commit .env.

# --- server -------------------------------------------------------------
PORT=8770

# --- auth (HTTP Basic, single user) -------------------------------------
TV_USER=change-me
TV_PASS=change-me

# --- paths --------------------------------------------------------------
# Only used when you run the binary directly. Docker Compose sets its own
# in-container paths (see docker-compose.yml), so these values are ignored there.
# Repo root on the host, or /app inside the container.
TV_BASE=.
TV_DATA_DIR=./data
TV_FRONTEND_DIR=./web
TV_MODELS_DIR=./backend/models
TV_PROMPTS_DIR=./backend/app

# --- AI ------------------------------------------------------------------
# Needed for explainers, inspire, frame labelling. Vault works without it.
OPENROUTER_API_KEY=
EXPLAINER_MODEL=google/gemini-2.5-flash
# TV_PREVIEW_IMAGE_MODEL=

# --- optional extras ----------------------------------------------------
# Voice-note transcription (OpenAI-compatible endpoint)
# PARAKEET_BASE_URL=http://host:5092/v1
# PARAKEET_MODEL=parakeet-tdt-0.6b-v3

# Share-token query bypass (optional)
# TV_SHARE_TOKEN=

# onnxruntime dylib, only when it is not on the default path
# ONNX Runtime ships inside the Docker image (pinned to 1.30.0 and checksummed).
# Only set this when you run the binary directly and keep the library elsewhere.
# ORT_DYLIB_PATH=/usr/local/lib/libonnxruntime.so.1.30.0
